# ==========================================
# LUZ & MEMORIA - CONFIGURACION DEL BACKEND
# ==========================================

# Configuracion anterior (compatibilidad)
FOTO_API_KEY=cambiar-clave-del-estudio-2026
POSTGRES_PASSWORD=cambiar-password-local-2026

# ==========================================
# BASE DE DATOS - SUPABASE POSTGRESQL
# ==========================================

# Copiar la URI del Session Pooler de Supabase.
# Sustituir los valores por las credenciales autorizadas.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST:5432/postgres?sslmode=require

# ==========================================
# AUTENTICACION
# ==========================================

# Utilizar un secreto aleatorio y privado.
JWT_SECRET_KEY=REEMPLAZAR_CON_SECRETO_SEGURO

# ==========================================
# SUPABASE STORAGE
# ==========================================

SUPABASE_URL=https://ID_PROYECTO.supabase.co

# Clave privada: usar exclusivamente en el backend.
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA

# Buckets privados
SUPABASE_BUCKET_COMPROBANTES=comprobantes-pago
SUPABASE_BUCKET_FOTOGRAFIAS=fotografias-eventos

# Base PostgreSQL exclusiva para pruebas de integracion.
# Nunca utilizar la misma conexion que DATABASE_URL.
TEST_DATABASE_URL=